{%- comment -%}
  Rukousaikojen asetukset JSON-oliona (rukousdata.html ja kalenteri/tiedot.json). Ajat tulevat vain lähteestä tai omasta
  aikataulusta (_data/aikataulut): sivu ei laske aikoja itse, ja päivä, jolle aikaa ei ole, jää tyhjäksi. Parametri: moskeija
{%- endcomment -%}
{%- assign m = include.moskeija -%}
{%- assign r = m.rukousajat -%}
{%- assign aikataulu = nil -%}
{%- assign kansio = r.aikataulu | default: m.slug -%}{%- comment -%} oletus: moskeijan slug {%- endcomment -%}
{%- if kansio and kansio != "" -%}{%- assign aikataulu = site.data.aikataulut[kansio] -%}{%- endif -%}
{%- capture _lahde -%}{% include osat/rk-lahde.html moskeija=m %}{%- endcapture -%}
{
  "lahde": {{ _lahde | jsonify }},
  "haku": {% if site.data.haku and site.data.haku[m.slug] %}{{ site.data.haku[m.slug] | jsonify }}{% else %}null{% endif %},
  "iqamah": {% if _lahde == "masjidbox" %}{% assign _iq = r.iqamah %}{% else %}{% assign _iq = r.iqamah | default: r.iqamah_oletus %}{% endif %}{% if _iq %}{{ _iq | jsonify }}{% else %}null{% endif %},
  "juma": {{ m.juma | default: "" | jsonify }},
  "juma2": {{ m.juma_2 | default: "" | jsonify }},
  "muutokset": {% if r.muutokset %}{{ r.muutokset | jsonify }}{% else %}[]{% endif %},
  "aikataulu": {% if aikataulu %}{{ aikataulu | jsonify }}{% else %}{}{% endif %}
}
