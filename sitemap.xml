<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%} Sivukartta hakukoneille. Yhteisistä lähteistä tuodut artikkelit eivät ole mukana (alkuperäinen on muualla). {%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign m = site.moskeijat | where: 'slug', site.moskeija | first -%}
{%- for p in site.html_pages %}{% if p.url contains "404" %}{% continue %}{% endif %}
  {%- assign _nimi = p.url | remove: "/" -%}{% if m.valikko_piilota contains _nimi %}{% continue %}{% endif %}{% if _nimi == "lahjoita" and m.lahjoitus == nil %}{% continue %}{% endif %}{% if _nimi == "artikkelit" and site.artikkelit.size == 0 %}{% continue %}{% endif %}
  <url><loc>{{ site.url }}{{ p.url | relative_url }}</loc>{% if p.url == "/" %}<priority>1.0</priority>{% endif %}</url>
{%- endfor %}
{%- for p in site.tapahtumat %}
  <url><loc>{{ site.url }}{{ p.url | relative_url }}</loc><lastmod>{{ p.paiva | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
{%- for p in site.sivut %}
  <url><loc>{{ site.url }}{{ p.url | relative_url }}</loc></url>
{%- endfor %}
{%- for p in site.artikkelit %}{% if p.lahde_url %}{% continue %}{% endif %}
  <url><loc>{{ site.url }}{{ p.url | relative_url }}</loc><lastmod>{{ p.paiva | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
